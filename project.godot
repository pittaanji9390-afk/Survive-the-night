; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by hand if needed.

config_version=5

[application]

config/name="Survive the Night"
config/description="A modular 2D top-down survival and base-building game."
config/version="1.0.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://core/events/event_bus.gd"
ServiceLocator="*res://core/services/service_locator.gd"
GameConfig="*res://core/configuration/game_config.gd"
GameStateManager="*res://core/managers/game_state_manager.gd"
TimeManager="*res://core/managers/time_manager.gd"
InputManager="*res://core/managers/input_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

